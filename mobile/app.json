{
  "expo": {
    "name": "Quốc Hưng Scales",
    "slug": "qhs-scales-mobile",
    "scheme": "qhsscales",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "version": "1.0.0",
    "icon": "./assets/app-icon.png",
    "splash": {
      "image": "./assets/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.doluongquochung.scales",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.doluongquochung.scales",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "assetBundlePatterns": ["**/*"],
    "plugins": ["expo-router"]
  }
}
